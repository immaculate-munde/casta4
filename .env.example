# Repo root — used by rag-server.js (copy to .env, do not commit .env)
GROQ_API_KEY=
CAT_MODEL_URL=http://localhost:8000
# Optional — persist uploads on Render (exposure, EP CSV, RAG docs, manifest):
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # API only — never commit or expose to browser
# CASTA4_WORKSPACE_ID=default  # row id in casta4_workspaces (shared demo = default)

# Optional:
# GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_MAX_TOKENS=500
# WORKSPACE_ROOT=              # filesystem fallback when Supabase not set
# CAT_MODEL_TIMEOUT_MS=120000
